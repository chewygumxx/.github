{
    "name": ".github",
    "description": "Shared GitHub configuration for chewygumxx repositories",
    "private": true,
    "keywords": [
        "github",
        "repository"
    ],
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/chewygumxx/.github",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/chewygumxx/.github.git"
    },
    "engines": {
        "bun": ">=1.4"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@chewygumxx/biome-config": "^1.0.0",
        "@chewygumxx/commitlint-config": "^1.1.0",
        "@chewygumxx/cz-commitlint": "^1.0.2",
        "@chewygumxx/hk-config": "0.1.0",
        "@chewygumxx/markdownlint-cli2-config": "^1.1.0",
        "@chewygumxx/mise-tasks-config": "0.1.0",
        "@chewygumxx/remark-preset": "^1.0.3",
        "@commitlint/cli": "^21.2.2",
        "@types/bun": "^1.4.2",
        "commitizen": "^4.3.2",
        "markdownlint-cli2": "^0.23.3",
        "prettier": "^3.9.9",
        "remark-cli": "^12.0.1",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "check": "mise run check --all"
    },
    "config": {
        "commitizen": {
            "path": "@chewygumxx/cz-commitlint"
        }
    },
    "remarkConfig": {
        "plugins": [
            "@chewygumxx/remark-preset"
        ]
    }
}
